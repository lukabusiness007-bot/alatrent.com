# Supabase/PostgreSQL — server-only connection string. Never use NEXT_PUBLIC.
# POSTGRES_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@YOUR_POOLER:6543/postgres?sslmode=require
# Optional migration/session connection:
# POSTGRES_URL_NON_POOLING=postgresql://postgres.PROJECT:YOUR_PASSWORD@YOUR_POOLER:5432/postgres?sslmode=require
# POSTGRES_SCHEMA=alat_rent
# Without POSTGRES_URL, local development uses SQLite; Vercel stays read-only.

# Absolute path to a persistent, writable directory (optional; defaults to ./data).
# DATA_DIR=/var/lib/rent-tools
# First-time admin bootstrap only; never use a NEXT_PUBLIC variable.
# ADMIN_PASSWORD=
# PORT=3010
# APP_HOST=0.0.0.0
# Set only when deployed to the real HTTPS domain.
# SITE_URL=https://your-domain.rs

# WhatsApp Business Platform. Secrets stay on the server, never in NEXT_PUBLIC variables.
# Configure the current API version supported by your Meta application (e.g. vXX.X).
# WHATSAPP_API_VERSION=vXX.X
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Use an independently generated random secret for the background worker.
# COMMERCE_JOB_SECRET=
# COMMERCE_APP_URL=http://127.0.0.1:3010

# Optional verification tokens from the corresponding webmaster accounts.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Transactional Alat Rent email (server only). Vercel uses short-lived OIDC
# credentials for an IAM role limited to ses:SendEmail from noreply@alatrent.rs.
# SES_ENABLED=true
# SES_REGION=eu-north-1
# SES_ROLE_ARN=arn:aws:iam::005783448821:role/AlatRentSesMailer
# SES_REPLY_TO=alatrentbeograd@gmail.com
# Vercel's daily recovery job authenticates with this secret. Immediate delivery
# runs after successful form submissions; the cron only retries pending mail.
# CRON_SECRET=
# Local SES testing can use the standard AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# provider instead of SES_ROLE_ARN. Never expose these as NEXT_PUBLIC variables.
