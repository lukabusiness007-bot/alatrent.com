{
  "name": "rent-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "admin:reset": "node --env-file-if-exists=.env.local scripts/reset-admin.mjs",
    "commerce:worker": "node --env-file-if-exists=.env.local scripts/commerce-worker.mjs",
    "commerce:tick": "node --env-file-if-exists=.env.local scripts/commerce-worker.mjs --once",
    "seo:report": "node scripts/seo-report.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@vercel/functions": "^3.10.1",
    "@vercel/oidc-aws-credentials-provider": "^3.3.15",
    "lucide-react": "^1.54.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
